# =========================================================
# CONTACT
# =========================================================

async def contact_handler(update, context):

    if not update.message:
        return

    contact = update.message.contact
    user = update.effective_user

    if not contact or not user:
        return

    user_id = user.id

    logger.info(
        "Contact received from Telegram ID: %s",
        user_id
    )

    # -----------------------------------------------------
    # امنیت: فقط شماره متعلق به خود کاربر پذیرفته شود
    # -----------------------------------------------------

    if contact.user_id != user_id:

        logger.warning(
            "Rejected contact from %s: contact belongs to %s",
            user_id,
            contact.user_id
        )

        await update.message.reply_text(
            "❌ لطفاً فقط شماره تماس خودت را با دکمه «ارسال شماره تماس من» ارسال کن.",
            reply_markup=contact_keyboard()
        )

        return

    phone_number = contact.phone_number

    # -----------------------------------------------------
    # ذخیره اطلاعات در حافظه
    # -----------------------------------------------------

    verified_users.add(user_id)

    user_contacts[user_id] = {
        "telegram_id": user_id,
        "first_name": user.first_name or "",
        "last_name": user.last_name or "",
        "username": user.username or "",
        "phone": phone_number,
    }

    full_name = (
        f"{user.first_name or ''} {user.last_name or ''}"
    ).strip()

    if not full_name:
        full_name = "بدون نام"

    username = (
        f"@{user.username}"
        if user.username
        else "ندارد"
    )

    # -----------------------------------------------------
    # پیام ادمین
    # -----------------------------------------------------

    admin_text = (
        "👤 کاربر جدید Teamup AI\n\n"
        f"نام: {full_name}\n"
        f"Username: {username}\n"
        f"Telegram ID: {user_id}\n"
        f"📱 شماره تماس: {phone_number}"
    )

    logger.info(
        "Trying to send user information to ADMIN_ID=%s",
        ADMIN_ID
    )

    try:

        await context.bot.send_message(
            chat_id=ADMIN_ID,
            text=admin_text
        )

        logger.info(
            "SUCCESS: User information sent to admin %s",
            ADMIN_ID
        )

    except Exception as e:

        # -------------------------------------------------
        # مهم: خطای واقعی را در ترمینال نشان می‌دهیم
        # -------------------------------------------------

        logger.exception(
            "FAILED to send user information to admin."
        )

        print("\n" + "=" * 60)
        print("❌ ADMIN SEND ERROR")
        print("=" * 60)
        print(f"ADMIN_ID: {ADMIN_ID}")
        print(f"ERROR TYPE: {type(e).__name__}")
        print(f"ERROR: {e}")
        print("=" * 60 + "\n")

        await update.message.reply_text(
            "❌ اطلاعات ثبت شد، اما ارسال اطلاعات برای مدیر با خطا مواجه شد.\n\n"
            "لطفاً کمی بعد دوباره تلاش کن."
        )

        return

    # -----------------------------------------------------
    # موفقیت
    # -----------------------------------------------------

    await update.message.reply_text(
        "✅ شماره تماس با موفقیت ثبت شد.\n\n"
        "حالا می‌تونی از Teamup AI استفاده کنی. 🤖",
        reply_markup=ReplyKeyboardRemove()
    )

    await update.message.reply_text(
        "🏠 **منوی اصلی**\n\n"
        "یک گزینه را انتخاب کن:",
        reply_markup=main_menu(),
        parse_mode="Markdown"
    )


