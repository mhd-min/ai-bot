async def button_handler(update, context):

    query = update.callback_query

    if not query:
        return

    await query.answer()

    user = query.from_user
    user_id = user.id
    data = query.data

    # -----------------------------------------------------
    # بررسی ثبت شماره
    # -----------------------------------------------------

    if not is_verified(user_id):

        await query.message.reply_text(
            "ابتدا باید شماره تماس خودت را ثبت کنی.",
            reply_markup=contact_keyboard()
        )

        return

    # -----------------------------------------------------
    # MAIN MENU
    # -----------------------------------------------------

    if data == "main_menu":

        await query.edit_message_text(
            "🏠 **منوی اصلی Teamup AI**",
            reply_markup=main_menu(),
            parse_mode="Markdown"
        )

        return

    # -----------------------------------------------------
    # NEW CHAT
    # -----------------------------------------------------

    if data == "new_chat":

        reset_conversation(user_id)

        await query.edit_message_text(
            "🆕 گفت‌وگوی جدید شروع شد.\n\n"
            "پیامت رو بفرست."
        )

        return

    # -----------------------------------------------------
    # CONTINUE
    # -----------------------------------------------------

    if data == "continue_chat":

        messages = get_user_messages(user_id)

        count = len(
            [
                m for m in messages
                if m["role"] == "user"
            ]
        )

        await query.edit_message_text(
            f"🧠 گفت‌وگوی فعلی ادامه دارد.\n\n"
            f"تعداد پیام‌های کاربر: {count}\n\n"
            f"پیامت رو بفرست.",
        )

        return

    # -----------------------------------------------------
    # MODES
    # -----------------------------------------------------

    mode_map = {
        "mode_coding": ("coding", "💻 حالت برنامه‌نویسی"),
        "mode_study": ("study", "📚 حالت دستیار درسی"),
        "mode_writer": ("writer", "✍️ حالت نویسندگی"),
        "mode_translation": ("translation", "🌐 حالت مترجم"),
    }

    if data in mode_map:

        mode, title = mode_map[data]

        reset_conversation(user_id)
        add_mode(user_id, mode)

        await query.edit_message_text(
            f"{title} فعال شد.\n\n"
            "پیامت رو بفرست."
        )

        return

    # -----------------------------------------------------
    # SETTINGS
    # -----------------------------------------------------

    if data == "settings":

        await query.edit_message_text(
            "⚙️ **تنظیمات**",
            reply_markup=settings_menu(),
            parse_mode="Markdown"
        )

        return

    # -----------------------------------------------------
    # MODEL SELECTION
    # -----------------------------------------------------

    if data == "select_model":

        await query.edit_message_text(
            "🤖 **انتخاب مدل**\n\n"
            "مدل موردنظر را انتخاب کن:",
            reply_markup=model_menu(user_id),
            parse_mode="Markdown"
        )

        return

    # -----------------------------------------------------
    # CLAUDE
    # -----------------------------------------------------

    if data == "model_claude":

        user_models[user_id] = MODELS["claude"]

        await query.edit_message_text(
            "✅ **Claude Sonnet 4.6** انتخاب شد.",
            reply_markup=model_menu(user_id),
            parse_mode="Markdown"
        )

        return

    # -----------------------------------------------------
    # GPT
    # -----------------------------------------------------

    if data == "model_gpt":

        await query.answer(
            "GPT-6 Luna هنوز در رویداد APMIX فعال نشده.",
            show_alert=True
        )

        return

    # -----------------------------------------------------
    # MEMORY
    # -----------------------------------------------------

    if data == "memory":

        messages = get_user_messages(user_id)

        user_message_count = len(
            [
                m for m in messages
                if m["role"] == "user"
            ]
        )

        await query.edit_message_text(
            "🧠 **حافظه گفتگو**\n\n"
            f"پیام‌های ذخیره‌شده در گفت‌وگوی فعلی: {user_message_count}\n\n"
            "حافظه حرفه‌ای بلندمدت هنوز در حال توسعه است.",
            reply_markup=settings_menu(),
            parse_mode="Markdown"
        )

        return

    # -----------------------------------------------------
    # ABOUT
    # -----------------------------------------------------

    if data == "about":

        await query.edit_message_text(
            "🤖 **Teamup AI**\n\n"
            "دستیار هوش مصنوعی فارسی‌زبان\n"
            "مدل پیش‌فرض: Claude Sonnet 4.6"
             "🚀 Powered by Teamup\n",
            reply_markup=main_menu(),
            parse_mode="Markdown"
        )

        return


