def is_verified(user_id):
    return user_id in verified_users


def get_user_messages(user_id):
    if user_id not in conversations:
        conversations[user_id] = [
            {
                "role": "system",
                "content": SYSTEM_PROMPT
            }
        ]

    return conversations[user_id]


def reset_conversation(user_id):
    conversations[user_id] = [
        {
            "role": "system",
            "content": SYSTEM_PROMPT
        }
    ]


def add_mode(user_id, mode):
    messages = get_user_messages(user_id)

    messages.append(
        {
            "role": "system",
            "content": MODE_PROMPTS[mode]
        }
    )


# =========================================================
# APMIX
# =========================================================

def ask_apmix(messages, model):

    payload = {
        "model": model,
        "messages": messages
    }

    payload_json = json.dumps(
        payload,
        ensure_ascii=False
    )

    command = [
        "curl.exe",
        "-sS",
        "--http1.1",
        APMIX_URL,

        "-H",
        f"Authorization: Bearer {APMIX_API_KEY}",

        "-H",
        "Content-Type: application/json",

        "--data",
        payload_json,
    ]

    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=False,
            timeout=120
        )

    except subprocess.TimeoutExpired:
        raise RuntimeError(
            "APMIX: درخواست بیشتر از زمان مجاز طول کشید."
        )

    except Exception as e:
        raise RuntimeError(
            f"خطا در اجرای curl: {e}"
        )

    stdout = result.stdout.decode(
        "utf-8",
        errors="replace"
    )

    stderr = result.stderr.decode(
        "utf-8",
        errors="replace"
    )

    if stderr.strip():
        logger.warning(
            "curl stderr: %s",
            stderr
        )

    if not stdout.strip():
        raise RuntimeError(
            f"APMIX پاسخ خالی داد. stderr: {stderr}"
        )

    try:
        data = json.loads(stdout)

    except json.JSONDecodeError:
        raise RuntimeError(
            f"APMIX پاسخ JSON معتبر نبود:\n{stdout[:1000]}"
        )

    if "error" in data:
        error = data["error"]

        if isinstance(error, dict):
            message = error.get(
                "message",
                str(error)
            )
        else:
            message = str(error)

        raise RuntimeError(
            f"APMIX: {message}"
        )

    try:
        answer = data["choices"][0]["message"]["content"]

    except (KeyError, IndexError, TypeError):
        raise RuntimeError(
            f"ساختار پاسخ APMIX غیرمنتظره بود:\n{json.dumps(data, ensure_ascii=False)[:2000]}"
        )

    return answer


