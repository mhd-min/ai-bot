async def message_handler(update, context):

    if not update.message:
        return

    if not update.effective_user:
        return

    user_id = update.effective_user.id
    text = update.message.text

    if not text:
        return

    # -----------------------------------------------------
    # Verification
    # -----------------------------------------------------

    if not is_verified(user_id):

        await update.message.reply_text(
            "برای استفاده از Teamup AI ابتدا شماره تماس خودت را ثبت کن.",
            reply_markup=contact_keyboard()
        )

        return

    # -----------------------------------------------------
    # Conversation
    # -----------------------------------------------------

    messages = get_user_messages(user_id)

    messages.append(
        {
            "role": "user",
            "content": text
        }
    )

    model = user_models.get(
        user_id,
        DEFAULT_MODEL
    )

    # -----------------------------------------------------
    # Typing
    # -----------------------------------------------------

    try:

        await update.message.chat.send_action(
            ChatAction.TYPING
        )

    except Exception:
        pass

    # -----------------------------------------------------
    # APMIX
    # -----------------------------------------------------

    try:

        answer = await asyncio.to_thread(
            ask_apmix,
            messages,
            model
        )

    except Exception as e:

        logger.exception(
            "APMIX request failed."
        )

        await update.message.reply_text(
            f"❌ خطا در ارتباط با هوش مصنوعی:\n\n{e}"
        )

        return

    # -----------------------------------------------------
    # Save assistant message
    # -----------------------------------------------------

    messages.append(
        {
            "role": "assistant",
            "content": answer
        }
    )

    # -----------------------------------------------------
    # Telegram message limit
    # -----------------------------------------------------

    MAX_LENGTH = 4000

    if len(answer) <= MAX_LENGTH:

        await update.message.reply_text(
            answer
        )

    else:

        for i in range(
            0,
            len(answer),
            MAX_LENGTH
        ):

            chunk = answer[
                i:i + MAX_LENGTH
            ]

            await update.message.reply_text(
                chunk
            )


# =========================================================
# ERROR HANDLER
# =========================================================

async def error_handler(update, context):

    logger.exception(
        "Unhandled exception:",
        exc_info=context.error
    )


# =========================================================
# MAIN
# =========================================================

def main():

    logger.info(
        "Starting Teamup AI bot..."
    )

    logger.info(
        "Using default model: %s",
        DEFAULT_MODEL
    )

    logger.info(
        "Configured ADMIN_ID: %s",
        ADMIN_ID
    )

    application = (
        Application.builder()
        .token(TELEGRAM_BOT_TOKEN)
        .post_init(post_init)
        .build()
    )

    # -----------------------------------------------------
    # Commands
    # -----------------------------------------------------

    application.add_handler(
        CommandHandler(
            "start",
            start_command
        )
    )

    application.add_handler(
        CommandHandler(
            "help",
            help_command
        )
    )

    application.add_handler(
        CommandHandler(
            "newchat",
            new_chat_command
        )
    )

    application.add_handler(
        CommandHandler(
            "clear",
            clear_command
        )
    )

    application.add_handler(
        CommandHandler(
            "model",
            model_command
        )
    )

    application.add_handler(
        CommandHandler(
            "about",
            about_command
        )
    )

    # -----------------------------------------------------
    # CONTACT
    # -----------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.CONTACT,
            contact_handler
        )
    )

    # -----------------------------------------------------
    # BUTTONS
    # -----------------------------------------------------

    application.add_handler(
        CallbackQueryHandler(
            button_handler
        )
    )

    # -----------------------------------------------------
    # TEXT
    # -----------------------------------------------------

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            message_handler
        )
    )

    # -----------------------------------------------------
    # ERROR
    # -----------------------------------------------------

    application.add_error_handler(
        error_handler
    )

    logger.info(
        "Bot is running..."
    )

    application.run_polling(
        drop_pending_updates=True
    )


# =========================================================
# RUN
# =========================================================

if __name__ == "__main__":
    main()
